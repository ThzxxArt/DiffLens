{
  "name": "DiffLens",
  "version": "0.12.1",
  "description": "DiffLens — 精美酷炫的文本对比桌面应用",
  "author": "ThzxxArt",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "desktopName": "difflens.desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThzxxArt/DiffLens.git"
  },
  "homepage": "https://github.com/ThzxxArt/DiffLens#readme",
  "bugs": {
    "url": "https://github.com/ThzxxArt/DiffLens/issues"
  },
  "keywords": [
    "diff",
    "text-diff",
    "file-comparison",
    "electron",
    "react",
    "typescript",
    "desktop-app",
    "developer-tools"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:unit": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:linux:rpm": "electron-vite build && electron-builder --linux rpm"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "diff": "^9.0.0",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "iconv-lite": "^0.7.3",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "electron-winstaller@5.4.0": true
  }
}
